# Copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
# Public URL of the app (used for OAuth redirects and CORS)
BASE_URL=http://localhost:3000
# Extra origins allowed to call the API with cookies, comma separated (optional)
ALLOWED_ORIGINS=

# Required in production: a random string of 32+ characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ---------------------------------------------------------------------------
# Firebase Admin (Firestore + Cloud Storage), server side only.
# Use ONE of: the whole service account JSON, the three separate fields,
# or a firebase-service-account.json file in the project root (local dev).
# On Cloud Run, Application Default Credentials are used automatically.
# ---------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# ---------------------------------------------------------------------------
# Google sign-in (OAuth 2.0 web client)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to $BASE_URL/api/auth/google/callback
GOOGLE_REDIRECT_URI=

# ---------------------------------------------------------------------------
# OpenAI (chat assistant, ATS scoring, interview analysis)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ---------------------------------------------------------------------------
# Outgoing email (interview invites). Emails are logged when unset.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@recruiver.com
MAIL_FROM_NAME=Recruiver Hiring
